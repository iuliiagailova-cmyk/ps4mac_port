diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 22f4bf7f..e6827773 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -1,3 +1,7 @@
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 /*
  * Copyright © 2022 Collabora Ltd. and Red Hat Inc.
  * Copyright 2025 LunarG, Inc.
@@ -244,9 +248,36 @@ kk_EndCommandBuffer(VkCommandBuffer commandBuffer)
    return vk_command_buffer_end(&cmd->vk);
 }
 
+/* ps4mac_port: KK_LABEL_ENCODERS=1 names Metal encoders after vkCmdInsertDebugUtilsLabelEXT, so
+ * Metal System Trace shows GPU time per Vulkan render pass or dispatch. A label inserted while no
+ * encoder is open (render encoders start at the first draw) names the next one. */
+static int
+kk_label_encoders(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *env = getenv("KK_LABEL_ENCODERS");
+      enabled = env && env[0] == '1';
+   }
+   return enabled;
+}
+
+static __thread struct {
+   const void *cmd;
+   char label[256];
+} kk_next_encoder_label;
+
 static void
 kk_encoder_update_debug(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
 {
+   if (kk_label_encoders() && kk_next_encoder_label.cmd == cmd &&
+       kk_next_encoder_label.label[0]) {
+      mtl_encoder_set_label(encoder, kk_next_encoder_label.label);
+      kk_next_encoder_label.label[0] = 0;
+      util_dynarray_foreach(&cmd->vk.labels, VkDebugUtilsLabelEXT, label)
+         mtl_encoder_push_debug_group(encoder, label->pLabelName);
+      return;
+   }
    /* Since there are many Metal command buffers and encoders for each Vulkan
     * command buffer, we need to copy debug state from Vulkan to Metal when
     * new Metal objects are created. */
@@ -325,6 +356,17 @@ cs_get_compute(struct kk_cmd_buffer *cmd)
       cmd->metal.compute = mtl_new_compute_command_encoder(cmd->metal.cmd_buf);
       mtl_compute_set_argument_table(cmd->metal.compute, cmd->argument_table);
       kk_encoder_update_debug(cmd, cmd->metal.compute);
+      /* ps4mac_port: with KK_LABEL_ENCODERS=1 a compute encoder is first named after the code
+       * that opened it (a later label from the application replaces the name). */
+      if (kk_label_encoders()) {
+         Dl_info info0 = {0}, info1 = {0};
+         dladdr(__builtin_return_address(0), &info0);
+         dladdr(__builtin_return_address(1), &info1);
+         char name[200];
+         snprintf(name, sizeof(name), "kk: %s <- %s", info0.dli_sname ? info0.dli_sname : "?",
+                  info1.dli_sname ? info1.dli_sname : "?");
+         mtl_encoder_set_label(cmd->metal.compute, name);
+      }
    }
 
    return cmd->metal.compute;
@@ -334,7 +376,14 @@ static void
 end_encoder(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
 {
    /* TODO_KOSMICKRISP This is probably overkill */
-   mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   /* ps4mac_port measurement: KK_END_BARRIER=0 skips it (not correct in general). */
+   static int end_barrier = -1;
+   if (end_barrier < 0) {
+      const char *env = getenv("KK_END_BARRIER");
+      end_barrier = !(env && env[0] == '0');
+   }
+   if (end_barrier)
+      mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
    mtl_end_encoding(encoder);
    mtl_release(encoder);
 
@@ -1126,4 +1175,19 @@ kk_CmdInsertDebugUtilsLabelEXT(VkCommandBuffer _commandBuffer,
    if (cmd->metal.compute)
       mtl_encoder_insert_debug_signpost(cmd->metal.compute,
                                         pLabelInfo->pLabelName);
+
+   /* Labels of render passes ("pass ...") name the render encoder, which starts at the pass's
+    * first draw; others name the compute encoder that holds the work just recorded. */
+   if (kk_label_encoders()) {
+      const bool pass = !strncmp(pLabelInfo->pLabelName, "pass ", 5);
+      if (pass && cmd->metal.render) {
+         mtl_encoder_set_label(cmd->metal.render, pLabelInfo->pLabelName);
+      } else if (pass) {
+         kk_next_encoder_label.cmd = cmd;
+         snprintf(kk_next_encoder_label.label, sizeof(kk_next_encoder_label.label), "%s",
+                  pLabelInfo->pLabelName);
+      } else if (cmd->metal.compute) {
+         mtl_encoder_set_label(cmd->metal.compute, pLabelInfo->pLabelName);
+      }
+   }
 }
