--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c	2026-11-20 00:42:40
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c	2026-11-20 00:42:40
@@ -65,7 +65,12 @@
    util_dynarray_clear(&cmd->ts_stage_map);
 }
 
-/* Ends Metal command buffer recording and returns allocator to pool for reuse */
+/* Ends Metal command buffer recording.
+ *
+ * spartanport: the allocator stays with the command buffer and is reset when it is begun again
+ * (Vulkan guarantees the GPU is done with it by then). It used to go back to the pool here
+ * without ever being reset: every allocator kept the commands of all its past command buffers,
+ * and after a few minutes of heavy rendering creating an encoder crashed inside Metal. */
 static void
 end_recording(struct kk_cmd_buffer *cmd)
 {
@@ -74,8 +79,6 @@
 
    cs_end(cmd);
    mtl_end_command_buffer(cmd->metal.cmd_buf);
-   kk_cmd_pool_return_allocator(kk_cmd_buffer_pool(cmd), cmd->metal.allocator);
-   cmd->metal.allocator = NULL;
 }
 
 static void
@@ -90,6 +93,11 @@
 
    /* Ensure closed command buffer for safe returns to pool */
    end_recording(cmd);
+   if (cmd->metal.allocator) {
+      mtl_command_allocator_reset(cmd->metal.allocator);
+      kk_cmd_pool_return_allocator(pool, cmd->metal.allocator);
+      cmd->metal.allocator = NULL;
+   }
    if (cmd->metal.cmd_buf)
       kk_cmd_pool_return_cmd_buf(pool, cmd->metal.cmd_buf);
    cmd->metal.cmd_buf = NULL;
@@ -222,13 +230,15 @@
    cmd->one_time_submit =
       pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
 
-   /* vk_command_buffer_begin will reset the command buffer meaning the
-    * allocator may be returned to the pool. Request a new one. */
+   /* spartanport: reuse this command buffer's allocator, reset: its previous commands have
+    * completed (a command buffer is not begun while pending). */
    if (cmd->metal.allocator == NULL) {
       cmd->metal.allocator = kk_cmd_pool_get_allocator(pool);
 
       if (cmd->metal.allocator == NULL)
          goto fail_allocator;
+   } else {
+      mtl_command_allocator_reset(cmd->metal.allocator);
    }
    mtl_begin_command_buffer(cmd->metal.cmd_buf, cmd->metal.allocator);
 
