  * Copyright © 2022 Collabora Ltd. and Red Hat Inc.
  * Copyright 2025 LunarG, Inc.
@@ -260,6 +263,33 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    if (vk_queue_is_lost(&queue->vk))
       return VK_ERROR_DEVICE_LOST;
 
+   /* ps4mac_port: KK_CAPTURE_TRIGGER=<file>: when the file appears it is removed and a Metal
+    * capture of the next KK_CAPTURE_SUBMITS submissions (default 60, about two R&C frames) is
+    * written to KK_CAPTURE_DIRECTORY/<process>.gputrace. Needs MTL_CAPTURE_ENABLED=1. */
+   {
+      static int capture_trigger = -1;
+      static const char *trigger_path;
+      static int capture_left;
+      if (capture_trigger < 0) {
+         trigger_path = getenv("KK_CAPTURE_TRIGGER");
+         capture_trigger = trigger_path && trigger_path[0];
+      }
+      if (capture_trigger) {
+         if (capture_left == 0 && access(trigger_path, F_OK) == 0) {
+            unlink(trigger_path);
+            const char *count = getenv("KK_CAPTURE_SUBMITS");
+            capture_left = count ? atoi(count) : 60;
+            if (capture_left <= 0)
+               capture_left = 60;
+            mtl_start_gpu_capture(dev->mtl_handle, getenv("KK_CAPTURE_DIRECTORY"));
+            fprintf(stderr, "KK capture: started for %d submissions\n", capture_left);
+         } else if (capture_left > 0 && --capture_left == 0) {
+            mtl_stop_gpu_capture();
+            fprintf(stderr, "KK capture: written\n");
+         }
+      }
+   }
+
    for (struct vk_sync_wait *wait = submit->waits,
                             *end = submit->waits + submit->wait_count;
         wait != end; ++wait) {
