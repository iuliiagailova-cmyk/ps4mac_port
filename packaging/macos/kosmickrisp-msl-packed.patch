 struct msl_compile_data {
+   /* spartanport: NULL while packed; kk_msl_code() gives the text. */
    char *code;
    char *entrypoint_name;
+   /* spartanport: the MSL text deflated (it is only needed again to build another pipeline
+    * from this shader or to serialize it): ~900 MB of text stayed in memory otherwise. */
+   uint8_t *packed;
+   uint32_t packed_size;
+   uint32_t code_size; /* strlen + 1 */
 };
+
+void kk_msl_pack(struct msl_compile_data *data);
+/* The MSL text; free it with kk_msl_code_done(). */
+const char *kk_msl_code(const struct msl_compile_data *data);
+void kk_msl_code_done(const struct msl_compile_data *data, const char *code);
 
