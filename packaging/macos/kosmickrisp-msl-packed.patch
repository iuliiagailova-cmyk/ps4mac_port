+void
+kk_msl_pack(struct msl_compile_data *data)
+{
+   static int disabled = -1;
+   if (disabled < 0)
+      disabled = getenv("KK_MSL_UNPACKED") != NULL;
+   if (disabled || data->code == NULL || data->packed)
+      return;
+   const size_t size = strlen(data->code) + 1;
+   uint8_t *packed = ralloc_array(NULL, uint8_t, util_compress_max_compressed_len(size));
+   const size_t packed_size =
+      packed ? util_compress_deflate((const uint8_t *)data->code, size, packed,
+                                     util_compress_max_compressed_len(size))
+             : 0;
+   if (packed_size == 0) {
+      ralloc_free(packed);
+      return;
+   }
+   data->packed = reralloc_array_size(NULL, packed, 1, packed_size);
+   data->packed_size = packed_size;
+   data->code_size = size;
+   ralloc_free(data->code);
+   data->code = NULL;
+}
+
+const char *
+kk_msl_code(const struct msl_compile_data *data)
+{
+   if (data->code)
+      return data->code;
+   char *code = malloc(data->code_size);
+   if (code && !util_compress_inflate(data->packed, data->packed_size,
+                                      (uint8_t *)code, data->code_size)) {
+      free(code);
+      return NULL;
+   }
+   return code;
+}
+
+void
+kk_msl_code_done(const struct msl_compile_data *data, const char *code)
+{
+   if (code != data->code)
+      free((void *)code);
+}
